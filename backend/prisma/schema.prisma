generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int        @id @default(autoincrement())
  username  String     @unique
  password  String
  fullName  String
  role      Role       @default(STAFF)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  auditLogs AuditLog[]
  payments  Payment[]
  staff     Staff?
  notifications Notification[]
  incomes   Income[]
  expenses  Expense[]
}

enum Role {
  ADMIN
  MANAGER
  STAFF
}

model Customer {
  id            Int       @id @default(autoincrement())
  name          String
  phone         String    @unique
  address       String?
  area          String?
  pppoeUsername String    @unique
  pppoePassword String
  status        String    @default("ACTIVE")
  packageId     Int
  package       Package   @relation(fields: [packageId], references: [id])
  routerId      Int?
  router        Router?   @relation(fields: [routerId], references: [id])
  oltId         Int?
  olt           Olt?      @relation(fields: [oltId], references: [id])
  onu           Onu?
  opticalPower  Float?
  fiberSplitter String?
  fiberCore     String?
  invoices      Invoice[]
  tickets       SupportTicket[]
  collectionNote String?
  promisedPayDate DateTime?
  notesUpdatedAt DateTime?
  joinDate      DateTime  @default(now())
  expireDate    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([pppoeUsername])
  @@index([oltId])
}

model Package {
  id        Int        @id @default(autoincrement())
  name      String
  speed     String
  price     Float
  validity  Int
  customers Customer[]
}

model Invoice {
  id          Int       @id @default(autoincrement())
  customerId  Int
  customer    Customer  @relation(fields: [customerId], references: [id])
  month       String
  amount      Float
  discount    Float     @default(0)
  vat         Float     @default(0)
  total       Float
  dueDate     DateTime
  status      String    @default("UNPAID")
  publicToken String?   @unique
  payments    Payment[]
  createdAt   DateTime  @default(now())

  @@unique([customerId, month])
}

model Payment {
  id                   Int      @id @default(autoincrement())
  invoiceId            Int
  invoice              Invoice  @relation(fields: [invoiceId], references: [id])
  amount               Float
  method               String
  receivedBy           Int?
  receiver             User?    @relation(fields: [receivedBy], references: [id])
  trxId                String?  @unique
  gatewayPaymentId     String?
  gatewayStatus        String?
  gatewayCustomerPhone String?
  notes                String?
  date                 DateTime @default(now())
}

model Router {
  id        Int        @id @default(autoincrement())
  name      String
  ipAddress String
  apiPort   Int        @default(8728)
  username  String
  password  String
  isActive  Boolean    @default(true)
  customers Customer[]
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
}

model Staff {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone     String?
  address   String?
  joinDate  DateTime   @default(now())
  salary    Float?
  isActive  Boolean    @default(true)
}

model Income {
  id          Int      @id @default(autoincrement())
  category    String
  amount      Float
  description String?
  date        DateTime @default(now())
  recordedBy  Int
  recorder    User     @relation(fields: [recordedBy], references: [id])
}

model Expense {
  id          Int      @id @default(autoincrement())
  category    String
  amount      Float
  description String?
  date        DateTime @default(now())
  recordedBy  Int
  recorder    User     @relation(fields: [recordedBy], references: [id])
  billUrl     String?
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

enum OltBrand {
  BDCOM
  ECOM
  VSOL
  HUAWEI
  GENERIC
}

enum PonType {
  EPON
  GPON
}

enum CliProtocol {
  TELNET
  SSH
}

enum OnuStatus {
  ONLINE
  OFFLINE
  LOS
  DYING_GASP
  UNREGISTERED
}

model Olt {
  id              Int          @id @default(autoincrement())
  name            String
  brand           OltBrand     @default(BDCOM)
  ponType         PonType      @default(EPON)
  ipAddress       String
  snmpCommunity   String       @default("public")
  snmpPort        Int          @default(161)
  cliProtocol     CliProtocol  @default(TELNET)
  cliPort         Int          @default(23)
  username        String
  password        String
  enablePassword  String?      // Required for BDCOM 'enable' privileged mode
  ponPortCount    Int          @default(4)
  uplinkPortCount Int          @default(2)
  location        String?
  status          String       @default("ONLINE")
  isActive        Boolean      @default(true)
  isMock          Boolean      @default(false)
  hardwareModel   String?
  firmwareVersion String?
  uptime          String?
  cpuUsage        Float?
  temperature     Float?
  lastSyncAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  ponPorts        PonPort[]
  onus            Onu[]
  customers       Customer[]
}

model PonPort {
  id          Int       @id @default(autoincrement())
  oltId       Int
  olt         Olt       @relation(fields: [oltId], references: [id], onDelete: Cascade)
  portNumber  Int       // 1..16
  portName    String    // e.g. "EPON0/1" or "GPON0/1"
  adminStatus String    @default("UP") // UP, DOWN
  operStatus  String    @default("UP") // UP, DOWN
  maxOnus     Int       @default(64)
  sfpModel    String?
  txPower     Float?    // SFP Optical Transmit Power (dBm, e.g. +4.5)
  rxPower     Float?    // OLT aggregate Rx Power (dBm)
  temperature Float?    // SFP Temperature (°C)
  voltage     Float?    // Voltage (V)
  current     Float?    // Current (mA)
  description String?

  onus        Onu[]

  @@unique([oltId, portNumber])
}

model Onu {
  id                   Int        @id @default(autoincrement())
  oltId                Int
  olt                  Olt        @relation(fields: [oltId], references: [id], onDelete: Cascade)
  ponPortId            Int?
  ponPortRef           PonPort?   @relation(fields: [ponPortId], references: [id], onDelete: SetNull)
  portNumber           Int        // 1..16
  onuId                Int        // Slot/LLID on PON port (1..64)
  macAddress           String?    // For EPON (e.g. "E0:67:B3:XX:XX:XX")
  serialNumber         String?    // For GPON (e.g. "BDCM12345678")
  name                 String?    // Customer or ONU label
  model                String?    // e.g. "V2801SG", "HG6143D"
  vendor               String?
  status               OnuStatus  @default(ONLINE)
  rxPower              Float?     // ONU Received Optical Power in dBm (e.g. -21.5 dBm)
  txPower              Float?     // ONU Transmit Optical Power in dBm (e.g. +2.1 dBm)
  oltRxPower           Float?     // OLT Received Optical Power from this ONU (dBm)
  distance             Float?     // Distance in meters (e.g. 1450m)
  vlanId               Int?
  vlanMode             String?    @default("TAG") // TAG, TRANSLATE, TRANSPARENT
  isAuthorized         Boolean    @default(true)
  lastOnline           DateTime?
  lastOffline          DateTime?
  lastDeregisterReason String?    // "Loss of Signal (LOS)", "Power Off (Dying Gasp)"
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  customerId           Int?       @unique
  customer             Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([oltId, portNumber, onuId])
  @@index([macAddress])
  @@index([serialNumber])
}

model SupportTicket {
  id          Int       @id @default(autoincrement())
  ticketNo    String    @unique
  customerId  Int
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subject     String
  category    String    @default("GENERAL") // NO_INTERNET, SLOW_SPEED, OPTICAL_LOS, BILLING, PACKAGE_CHANGE, ROUTER_CONFIG, OTHER
  priority    String    @default("MEDIUM")  // LOW, MEDIUM, HIGH, URGENT
  status      String    @default("OPEN")    // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  message     String
  adminReply  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([customerId])
  @@index([status])
}